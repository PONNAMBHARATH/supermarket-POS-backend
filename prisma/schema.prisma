generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  CASHIER
}

enum PaymentMode {
  CASH
  UPI
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  role         Role     @default(CASHIER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  sales        Sale[]
}

model Counter {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)
  sales  Sale[]
}

model Product {
  id           Int        @id @default(autoincrement())
  barcode      String?    @unique
  sku          String?    @unique
  name         String
  description  String?    @db.Text
  category     String?
  unit         String     @default("pcs")
  sellingPrice Decimal    @db.Decimal(12, 2)
  purchaseCost Decimal    @default(0) @db.Decimal(12, 2)
  taxRate      Decimal    @default(0) @db.Decimal(5, 2)
  imageUrl     String?    @db.VarChar(2048)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  saleItems    SaleItem[]

  @@index([name])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  createdAt DateTime @default(now())
  sales     Sale[]
}

model Sale {
  id          Int         @id @default(autoincrement())
  checkoutKey String?     @unique
  requestHash String?
  invoiceNo   String      @unique
  customerId  Int?
  userId      Int
  counterId   Int
  subtotal    Decimal     @db.Decimal(12, 2)
  discount    Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal    Decimal     @default(0) @db.Decimal(12, 2)
  grandTotal  Decimal     @db.Decimal(12, 2)
  paymentMode PaymentMode
  notes       String?
  createdAt   DateTime    @default(now())
  customer    Customer?   @relation(fields: [customerId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  counter     Counter     @relation(fields: [counterId], references: [id])
  items       SaleItem[]

  @@index([createdAt])
}

model SaleItem {
  id           Int     @id @default(autoincrement())
  saleId       Int
  productId    Int
  productName  String
  quantity     Decimal @db.Decimal(12, 3)
  unitPrice    Decimal @db.Decimal(12, 2)
  purchaseCost Decimal @db.Decimal(12, 2)
  taxRate      Decimal @db.Decimal(5, 2)
  lineTotal    Decimal @db.Decimal(12, 2)
  sale         Sale    @relation(fields: [saleId], references: [id])
  product      Product @relation(fields: [productId], references: [id])
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Offer {
  id          Int       @id @default(autoincrement())
  title       String
  message     String    @db.Text
  discountPct Decimal?  @db.Decimal(5, 2)
  imageUrl    String?   @db.VarChar(2048)
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
}
